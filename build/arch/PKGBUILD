# PKGBUILD for Kaulan (binary distribution).
#
# Installs Kaulan from the prebuilt .deb published on GitHub releases. The
# .deb already contains the binary, .desktop file, icons, and audio MIME
# associations; this PKGBUILD simply repackages it in pacman format.
#
# For a source-based build (slower, requires Rust + Node + FFmpeg dev
# headers), build the repo and run `./build-arch.sh` instead.
#
# Install locally:
#   cd build/arch
#   makepkg -si
#
# Verify checksums after bumping _pkgver:
#   updpkgsums   # or:  makepkg -g >> PKGBUILD

pkgname=kaulan-bin
_pkgname=kaulan
_pkgver=0.1.4
pkgver=${_pkgver}
pkgrel=1
pkgdesc="A Tauri-based music player with Rust actix-web backend and Vue.js frontend"
arch=('x86_64' 'aarch64')
url="https://github.com/Afeather2017/Kaulan"
license=('MIT')
depends=(
    'webkit2gtk-4.1'
    'gtk3'
    'librsvg'
    'hicolor-icon-theme'
    'ffmpeg'
)
provides=("${_pkgname}=$pkgver")
conflicts=("${_pkgname}")
options=('!strip' '!emptydirs')

# Map pacman arch to Tauri .deb arch inside the package() function.
source_x86_64=("${url}/releases/download/v${_pkgver}/kaulan_${_pkgver}_amd64.deb")
source_aarch64=("${url}/releases/download/v${_pkgver}/kaulan_${_pkgver}_arm64.deb")

# Replace these with `makepkg -g >> PKGBUILD` after bumping _pkgver.
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
    cd "$srcdir"

    # bsdtar reads the .deb via libarchive and extracts its three members
    # (debian-binary, control.tar.*, data.tar.*) into $srcdir.
    local deb
    deb="$(find . -maxdepth 1 -name 'kaulan_*.deb' | head -n1)"
    [ -n "$deb" ] || { error "downloaded .deb not found"; return 1; }
    bsdtar -xf "$deb"

    # data.tar.* holds the actual file tree (usr/bin, usr/share/applications,
    # usr/share/icons, ...). Extract it into $pkgdir.
    local data_tar
    data_tar="$(ls data.tar.* 2>/dev/null | head -n1)"
    [ -n "$data_tar" ] || { error "data.tar.* missing from .deb"; return 1; }
    bsdtar -xf "$data_tar" -C "$pkgdir"

    # Normalize ownership to root:root — Tauri's bundler already does this,
    # but enforce it in case the .deb was rebuilt by hand.
    find "$pkgdir" -exec chown root:root {} + 2>/dev/null || true
}
