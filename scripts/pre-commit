#!/bin/sh
# Pre-commit hook: refuse commit if:
# - Any submodule has uncommitted changes inside
# - Rust or TS code is not formatted

set -e

cd "$(git rev-parse --show-toplevel)"

# --- Submodules ---
# Block while any tracked submodule has uncommitted work inside. Otherwise
# those changes get left behind when the parent commit moves the pointer.
subs=$(sed -n 's/^[[:space:]]*path[[:space:]]*=[[:space:]]*//p' .gitmodules 2>/dev/null)
dirty=""
for sub in $subs; do
    [ ! -d "$sub" ] && continue
    if changes=$(env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE git -C "$sub" status --porcelain 2>/dev/null) && [ -n "$changes" ]; then
        dirty="${dirty:+$dirty }$sub"
    fi
done
if [ -n "$dirty" ]; then
    echo "" >&2
    echo "ERROR: Submodules with uncommitted changes:" >&2
    for sub in $dirty; do
        echo "  $sub" >&2
    done
    echo "" >&2
    echo "Commit (and push) inside each submodule first, or bypass with --no-verify." >&2
    exit 1
fi

# --- Rust ---
if ! cargo fmt --all --manifest-path backend/Cargo.toml -- --check; then
    echo "" >&2
    echo "ERROR: Rust code (backend) is not formatted. Run:" >&2
    echo "  cargo fmt --all --manifest-path backend/Cargo.toml" >&2
    exit 1
fi

if ! cargo fmt --all --manifest-path frontend/src-tauri/Cargo.toml -- --check; then
    echo "" >&2
    echo "ERROR: Rust code (frontend/src-tauri) is not formatted. Run:" >&2
    echo "  cargo fmt --all --manifest-path frontend/src-tauri/Cargo.toml" >&2
    exit 1
fi

# --- TypeScript / Vue / CSS ---
if ! (cd frontend && npx prettier --check "src/**/*.{ts,js,vue,css,html}"); then
    echo "" >&2
    echo "ERROR: Frontend code is not formatted. Run:" >&2
    echo "  cd frontend && npx prettier --write 'src/**/*.{ts,js,vue,css,html}'" >&2
    exit 1
fi

echo "All checks passed. Proceeding with commit."
