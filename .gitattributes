# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted
# to LF line endings on checkout.
*.rs text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.vue text eol=lf
*.ts text eol=lf
frontend/src/utils/collectionTransfer.ts diff
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.properties text eol=lf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.apk binary
*.aab binary
*.so binary
*.dll binary
*.exe binary
