{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "kaulan",
  "version": "0.1.4",
  "identifier": "afeather.kaulan",
  "build": {
    "frontendDist": "../dist/",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "kaulan",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../target/release/av*.dll": "",
      "../../target/release/sw*.dll": ""
    },
    "android": {
      "minSdkVersion": 24
    },
    "fileAssociations": [
      { "ext": ["mp3"], "name": "MP3 Audio", "mimeType": "audio/mpeg" },
      { "ext": ["flac"], "name": "FLAC Audio", "mimeType": "audio/flac" },
      { "ext": ["wav"], "name": "WAV Audio", "mimeType": "audio/wav" },
      { "ext": ["ogg", "oga"], "name": "Ogg Audio", "mimeType": "audio/ogg" },
      { "ext": ["opus"], "name": "Opus Audio", "mimeType": "audio/opus" },
      { "ext": ["m4a"], "name": "M4A Audio", "mimeType": "audio/mp4" },
      { "ext": ["aac"], "name": "AAC Audio", "mimeType": "audio/aac" }
    ]
  }
}
